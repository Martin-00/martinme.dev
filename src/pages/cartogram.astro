---
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import metrics from '../assets/cartogram/metrics.json';
import variables from '../assets/cartogram/variables.json';

const carto = metrics.cartogram;
const points = metrics.settings.points.toLocaleString('en-US');
const groups = [...new Set(variables.variables.map((v) => v.group))];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead
			title="Mexico Cartogram - Interactive Population Map by Municipio"
			description="Interactive population cartogram of Mexico: all 2,469 municipios sized by INEGI Census 2020 population, morphing from the real map. Built with the Gastner-Seguy-More flow-based algorithm and D3.js."
			keywords="mexico cartogram, cartograma mexico, mexico population map, mexico municipios map, INEGI census 2020, mexico interactive map, mexico data visualization, cartogram D3, flow-based cartogram, mexico population density"
		/>
		<script type="application/ld+json">
		{
			"@context": "https://schema.org",
			"@type": "CreativeWork",
			"name": "Mexico Population Cartogram",
			"description": "Interactive cartogram of Mexico: all 2,469 municipios sized by INEGI Census 2020 population, built with the Gastner-Seguy-More flow-based algorithm.",
			"author": {
				"@type": "Person",
				"name": "Martin Morales Estrada"
			},
			"datePublished": "2026-03-19",
			"dateModified": "2026-10-15",
			"url": "https://martinme.dev/cartogram",
			"keywords": ["cartogram", "Mexico", "population", "INEGI", "data visualization", "D3.js", "municipios"],
			"about": {
				"@type": "Place",
				"name": "Mexico"
			}
		}
		</script>
		<style>
			.cartogram-header {
				text-align: center;
				margin-bottom: 0.75em;
			}
			.cartogram-header h1 {
				font-size: 1.6em;
				margin: 0 0 0.2em;
			}
			.cartogram-header .subtitle {
				font-size: 0.85em;
				color: rgba(255, 255, 255, 0.4);
				font-style: italic;
			}
			.controls {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
				flex-wrap: wrap;
			}
			.controls button {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: rgba(255, 255, 255, 0.7);
				padding: 0.35em 0.9em;
				font-family: 'Source Serif', Georgia, serif;
				font-size: 0.75em;
				letter-spacing: 0.05em;
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.controls button:hover {
				background: rgba(255, 255, 255, 0.08);
				color: var(--accent);
			}
			.controls button.active {
				background: rgba(251, 191, 36, 0.1);
				border-color: var(--accent);
				color: var(--accent);
			}
			.control-group {
				display: flex;
			}
			.control-group button {
				margin-left: -1px;
			}
			.control-group button:first-child {
				margin-left: 0;
			}
			.control-separator {
				width: 1px;
				background: rgba(255, 255, 255, 0.1);
				margin: 0 0.75em;
			}
			@media (max-width: 720px) {
				.control-separator {
					display: none;
				}
				.controls {
					gap: 0.4em;
				}
				.controls button {
					padding: 0.35em 0.7em;
				}
				.color-picker {
					flex-basis: 100%;
				}
				.color-picker select {
					width: 100%;
				}
				.search {
					max-width: none;
				}
			}
			.color-picker select,
			.copy-link,
			.search input {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: rgba(255, 255, 255, 0.85);
				font-family: 'Source Serif', Georgia, serif;
				font-size: 0.75em;
				letter-spacing: 0.03em;
				padding: 0.35em 0.7em;
			}
			.color-picker {
				max-width: 100%;
			}
			.color-picker select {
				cursor: pointer;
				max-width: 100%;
			}
			.color-picker select:focus,
			.search input:focus {
				outline: none;
				border-color: var(--accent);
			}
			.color-picker option,
			.color-picker optgroup {
				background: #0a0f1e;
				color: #f0f0f0;
			}
			.finder {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
			}
			.search {
				position: relative;
				flex: 1 1 auto;
				max-width: 22em;
			}
			.search input {
				width: 100%;
				box-sizing: border-box;
			}
			.copy-link {
				cursor: pointer;
				white-space: nowrap;
			}
			.copy-link:hover {
				color: var(--accent);
			}
			.search-results {
				position: absolute;
				z-index: 300;
				left: 0;
				right: 0;
				top: 100%;
				margin: 2px 0 0;
				padding: 0.25em 0;
				list-style: none;
				background: rgba(5, 10, 25, 0.97);
				border: 1px solid rgba(255, 255, 255, 0.15);
				max-height: 18em;
				overflow-y: auto;
			}
			.search-results :global(li) {
				margin: 0;
				padding: 0.3em 0.75em;
				font-size: 0.8em;
				color: rgba(255, 255, 255, 0.85);
				cursor: pointer;
			}
			.search-results :global(li.active),
			.search-results :global(li:hover) {
				background: rgba(251, 191, 36, 0.12);
				color: var(--accent);
			}
			.search-results :global(.state) {
				color: rgba(255, 255, 255, 0.45);
			}
			.selection {
				text-align: center;
				font-size: 0.85em;
				color: rgba(255, 255, 255, 0.75);
				margin: 0.6em 0 0;
			}
			.selection :global(strong) {
				color: var(--accent);
			}
			.legend :global(.legend-bar) {
				position: relative;
				width: 12em;
				height: 10px;
				border-radius: 2px;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.legend :global(.legend-marker) {
				position: absolute;
				top: -4px;
				bottom: -4px;
				width: 2px;
				margin-left: -1px;
				background: #ffffff;
			}
			.map {
				position: relative;
				width: 100%;
			}
			.map canvas {
				display: block;
				width: 100%;
			}
			.map #map-base {
				touch-action: pan-x pan-y; /* one finger scrolls the page; two fingers zoom the map */
				cursor: grab;
			}
			.zoom-controls {
				position: absolute;
				top: 8px;
				right: 8px;
				display: flex;
				flex-direction: column;
				gap: 4px;
				z-index: 2;
			}
			.zoom-controls button {
				width: 30px;
				height: 30px;
				background: rgba(5, 10, 25, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: rgba(255, 255, 255, 0.85);
				font-size: 16px;
				line-height: 1;
				cursor: pointer;
			}
			.zoom-controls button:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.map-hint {
				text-align: center;
				font-size: 0.7em;
				color: rgba(255, 255, 255, 0.4);
				margin: 0.4em 0 0;
			}
			.map canvas + canvas {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			.tooltip {
				position: absolute;
				background: rgba(5, 10, 25, 0.92);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 0.5em 0.75em;
				font-size: 0.8em;
				color: #f0f0f0;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s ease;
				z-index: 200;
				backdrop-filter: blur(8px);
				-webkit-backdrop-filter: blur(8px);
			}
			.tooltip :global(.tt-name) {
				font-weight: 600;
				margin-bottom: 0.2em;
			}
			.tooltip :global(.tt-value) {
				color: rgba(255, 255, 255, 0.65);
				font-size: 0.9em;
			}
			.legend {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.6em;
				margin: 0.75em auto 0;
				padding: 0.6em 1.2em;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 6px;
				flex-wrap: wrap;
				font-size: 0.75em;
				color: rgba(255, 255, 255, 0.55);
				max-width: fit-content;
			}
			.legend:empty {
				display: none;
			}
			.legend :global(.legend-item) {
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.legend :global(.legend-swatch) {
				width: 14px;
				height: 14px;
				border-radius: 2px;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.loading {
				text-align: center;
				color: rgba(255, 255, 255, 0.4);
				padding: 3em 0;
				font-style: italic;
			}
			.explanation {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px dotted rgba(255, 255, 255, 0.1);
			}
			.explanation h2 {
				font-size: 1.2em;
				font-variant: small-caps;
				margin-bottom: 0.75em;
			}
			.explanation p,
			.explanation li {
				font-size: 0.92em;
				color: rgba(255, 255, 255, 0.8);
				line-height: 1.65;
			}
			.explanation-note {
				font-size: 0.8em !important;
				color: rgba(255, 255, 255, 0.4) !important;
				margin-top: 1.5em;
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="glass-card">
				<div class="cartogram-header">
					<h1>Mexico Cartogram</h1>
					<p class="subtitle">Every municipio sized by its people. INEGI Census 2020, all 2,469 municipios.</p>
				</div>

				<div class="controls">
					<div class="control-group">
						<button id="btn-cartogram" class="active">Cartogram</button>
						<button id="btn-normal">Normal</button>
					</div>
					<div class="control-separator"></div>
					<div class="control-group">
						<button id="btn-mun" class="active">Municipios</button>
						<button id="btn-state">States</button>
					</div>
					<div class="control-separator"></div>
					<label class="color-picker">
						<span class="sr-only">Color the map by</span>
						<select id="color-select">
							<option value="population">Color: population</option>
							<option value="state">Color: state</option>
							{groups.map((g) => (
								<optgroup label={g}>
									{variables.variables.filter((v) => v.group === g).map((v) => <option value={v.id}>{v.label}</option>)}
								</optgroup>
							))}
						</select>
					</label>
				</div>

				<div class="finder">
					<div class="search">
						<input id="search" type="search" placeholder="Find your municipio" autocomplete="off" spellcheck="false" aria-label="Find a municipio" aria-controls="search-results" />
						<ul id="search-results" class="search-results" role="listbox" hidden></ul>
					</div>
					<button id="copy-link" class="copy-link" type="button">Copy link</button>
				</div>

				<div class="map" id="map">
					<div class="loading" id="loading">Loading map data...</div>
					<canvas id="map-base" role="img" aria-label="Cartogram of Mexico's 2,469 municipios, each sized by its 2020 population"></canvas>
					<canvas id="map-overlay" aria-hidden="true"></canvas>
					<div class="zoom-controls">
						<button id="zoom-in" type="button" aria-label="Zoom in">+</button>
						<button id="zoom-out" type="button" aria-label="Zoom out">−</button>
						<button id="zoom-reset" type="button" aria-label="Reset zoom">⟲</button>
					</div>
				</div>
				<p class="map-hint">Zoom with two fingers, or ⌘/Ctrl + scroll; drag to explore; tap a place to select it.</p>
				<div id="legend" class="legend"></div>
				<p id="selection" class="selection" aria-live="polite" hidden></p>
				<div class="tooltip" id="tooltip"></div>

				<div class="explanation">
					<h2>What the cartogram reveals</h2>
					<p>
						The massive central bulge is where Mexico's gravity lives: Ciudad de Mexico,
						Estado de Mexico, Puebla, and Guadalajara. On a standard map, these states
						look like they share the country equally with Chihuahua and Durango. On the
						cartogram, they ARE Mexico. The central highlands contain more people than the
						entire north combined.
					</p>
					<p>
						Monterrey stands out clearly in the northeast, the industrial capital of
						northern Mexico. Tijuana and Mexicali swell out of Baja California, revealing
						the border economy that a standard map hides behind the peninsula's long, thin
						shape. The Yucatan holds its form because Merida and Cancun carry real population
						weight. And the vast deserts of Chihuahua, Durango, and Sonora? Compressed to
						thin strips, because almost nobody lives there.
					</p>

					<h2>Why this matters</h2>
					<p>
						A standard map of Mexico allocates visual weight by land area. Chihuahua
						dominates the north. But Chihuahua has 3.7 million people. Estado de Mexico
						has 17 million. On a normal map, they look roughly equal. A cartogram corrects
						this by making area proportional to population: what the eye sees matches
						where the people actually are.
					</p>
					<p>
						Every policy debate, every resource allocation, every electoral analysis
						that uses a standard map is starting from a distortion. Land doesn't vote.
						Land doesn't need hospitals. Land doesn't experience poverty. People do.
						A cartogram replaces geographic bias with demographic truth.
					</p>
					<p>
						At the municipio level, the distortion is even more revealing. Within each
						state, population concentrates in a few urban centers while vast rural
						territories hold very few people. Switch between "Normal" and "Cartogram" to
						watch the country reshape itself when you measure by people instead of land.
					</p>

					<h2>How it was built</h2>
					<p>
						The boundaries are INEGI's Marco Geoestadistico made for the 2020 census, so every
						one of the {carto.municipios.toLocaleString('en-US')} municipios matches its census
						count exactly: {carto.population.toLocaleString('en-US')} people in total. Shared
						borders are simplified once and moved together, so neighbouring municipios can never
						overlap. The map uses an equal-area projection, and the cartogram is computed with the
						Gastner-Seguy-More flow-based algorithm (via the authors' cartogram-cpp), across
						{points} border points.
					</p>
					<p>Measured on the final map, comparing each municipio's area with its share of the population:</p>
					<ul>
						<li>Median area error: {carto.area_error_median_pct}%, population-weighted: {carto.area_error_weighted_pct}%</li>
						<li>Worst municipio: {carto.area_error_max_pct}%</li>
						<li>Overlap between municipios: {carto.overlap_pct_of_area}% of the map</li>
						<li>
							Borders that cross themselves: {carto.invalid_polygons.toLocaleString('en-US')} municipios,
							covering {carto.self_crossing_pct_of_area}% of the map, almost all smaller than a pixel
						</li>
					</ul>
					<p>
						The colors come from the same census. Each rate uses INEGI's own denominator (people
						aged 3+ for languages, occupied homes for housing), and state and national figures are
						INEGI's official totals, never averages of municipios.
					</p>
					<p>
						The whole pipeline, from INEGI's files to these numbers, is reproducible from the
						repository. The map renders on a canvas in your browser; the site runs on AWS S3 and
						CloudFront for $0.51/month, with no backend.
					</p>
					<p class="explanation-note">
						<a href="https://github.com/Martin-00/martinme.dev/tree/main/scripts/cartogram" target="_blank" rel="noopener noreferrer">Pipeline source on GitHub</a>.
						Data: INEGI Marco Geoestadistico (Censo de Poblacion y Vivienda 2020) and Census 2020 ITER.
						Algorithm: Gastner, Seguy and More (2018), "Fast flow-based algorithm for creating
						density-equalizing map projections," PNAS.
					</p>
				</div>
			</div>
		</main>
		<Footer />

		<script>
			import * as d3 from 'd3';
			import * as topojson from 'topojson-client';
			import topoUrl from '../assets/cartogram/mexico.topo.json?url';
			import stateInfo from '../assets/cartogram/states.json';
			import variables from '../assets/cartogram/variables.json';

			type Ring = { a: Float32Array; b: Float32Array };
			type Region = {
				id: string;
				name: string;
				state: string;
				population: number;
				polygons: { a: number[][][][]; b: number[][][][] };
				rings: Ring[];
				boxA: number[];
				boxB: number[];
			};
			type Mesh = { lines: { a: number[][][]; b: number[][][] }; screen: Ring[] };
			type Variable = (typeof variables.variables)[number];

			const PAD = 8;
			const ASPECT = 0.64;
			const MORPH_MS = 1100;
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			const container = document.getElementById('map')!;
			const base = document.getElementById('map-base') as HTMLCanvasElement;
			const overlay = document.getElementById('map-overlay') as HTMLCanvasElement;
			const tooltip = d3.select('#tooltip');
			const names = stateInfo as Record<string, { name: string }>;

			const stateColors = [
				'#e6194b', '#3cb44b', '#ffe119', '#4363d8', '#f58231',
				'#911eb4', '#42d4f4', '#f032e6', '#bfef45', '#fabed4',
				'#469990', '#dcbeff', '#9A6324', '#fffac8', '#800000',
				'#aaffc3', '#808000', '#ffd8b1', '#000075', '#a9a9a9',
				'#e6beff', '#1abc9c', '#e74c3c', '#3498db', '#2ecc71',
				'#9b59b6', '#f39c12', '#1abc9c', '#e67e22', '#2980b9',
				'#27ae60', '#8e44ad'
			];
			const vars = new Map<string, Variable>(variables.variables.map((v) => [v.id, v]));
			const idIndex = new Map<string, number>(variables.ids.map((id, i) => [id, i]));
			const rateScales = new Map<string, d3.ScaleSequential<string>>(variables.variables.map((v) =>
				[v.id, d3.scaleSequential(d3.interpolateYlGnBu).domain(v.domain as [number, number]).clamp(true)]));
			const munScale = d3.scaleSequentialLog(d3.interpolateYlOrRd).domain([500, 2000000]);
			const stateScale = d3.scaleSequentialLog(d3.interpolateYlOrRd).domain([500000, 17000000]);

			let t = 0; // 0 = normal geography, 1 = cartogram
			let level: 'mun' | 'state' = 'mun';
			let colorVar = 'population';
			let timer: d3.Timer | null = null;
			let hovered: Region | null = null;
			let selected: Region | null = null;
			let view: 'cartogram' | 'normal' = 'cartogram';
			let zoomT = d3.zoomIdentity;
			let municipios: Region[] = [];
			let states: Region[] = [];
			let meshes: Record<'mun' | 'state' | 'outline', Mesh>;
			let width = 0;
			let height = 0;

			const asPolygons = (g: any): number[][][][] =>
				g.type === 'Polygon' ? [g.coordinates] : g.type === 'MultiPolygon' ? g.coordinates : [];

			function region(id: string, name: string, state: string, population: number, ga: any, gb: any): Region {
				return { id, name, state, population, polygons: { a: asPolygons(ga), b: asPolygons(gb) }, rings: [], boxA: [], boxB: [] };
			}

			async function load() {
				const topo = await fetch(topoUrl).then((r) => r.json());
				const cartoTopo = { ...topo, arcs: topo.cartogram.arcs, transform: topo.cartogram.transform };
				const obj = topo.objects.municipios;

				const fa = (topojson.feature(topo, obj) as any).features;
				const fb = (topojson.feature(cartoTopo, obj) as any).features;
				municipios = fa.map((f: any, i: number) => {
					const p = f.properties;
					return region(p.id, p.name, p.state, p.population, f.geometry, fb[i].geometry);
				});

				const byState = d3.group(obj.geometries, (g: any) => g.properties.state);
				states = Array.from(byState, ([code, geoms]: [string, any[]]) =>
					region(code, names[code].name, code, d3.sum(geoms, (g) => g.properties.population),
						topojson.merge(topo, geoms), topojson.merge(cartoTopo, geoms)));

				// Border lines are picked per arc by which municipios it separates, never by matching
				// coordinates, so both maps get identical line structures even where the cartogram squeezes hard.
				const decode = (t: any) => {
					const [sx, sy] = t.transform.scale;
					const [tx, ty] = t.transform.translate;
					return t.arcs.map((arc: number[][]) => {
						let x = 0, y = 0;
						return arc.map(([dx, dy]) => [(x += dx) * sx + tx, (y += dy) * sy + ty]);
					});
				};
				const arcsA = decode(topo);
				const arcsB = decode(cartoTopo);
				const owners = new Map<number, any[]>();
				for (const g of obj.geometries) {
					const polys = g.type === 'Polygon' ? [g.arcs] : g.arcs;
					for (const ring of polys.flat()) for (const i of ring) {
						const k = i < 0 ? ~i : i;
						owners.set(k, [...(owners.get(k) || []), g]);
					}
				}
				const mesh = (filter: (a: any, b: any) => boolean) => {
					const picked = [...owners].filter(([, gs]) => filter(gs[0], gs[1] ?? gs[0])).map(([k]) => k);
					return { lines: { a: picked.map((k) => arcsA[k]), b: picked.map((k) => arcsB[k]) }, screen: [] };
				};
				meshes = {
					mun: mesh((a, b) => a !== b && a.properties.state === b.properties.state),
					state: mesh((a, b) => a !== b && a.properties.state !== b.properties.state),
					outline: mesh((a, b) => a === b),
				};

				document.getElementById('loading')!.remove();
				applyURL();
				new ResizeObserver(layout).observe(container);
				layout();
				if (view === 'normal') {
					t = 0;
					draw();
				} else if (reducedMotion) {
					t = 1;
					draw();
				} else {
					setTimeout(() => morphTo(1), 600);
				}
				renderLegend();
				renderSelection();
				if (selected) setTimeout(() => zoomTo(selected!), reducedMotion || view === 'normal' ? 0 : 1800);
			}

			// Fit both maps to the canvas and convert every vertex to screen space once.
			function layout() {
				width = container.clientWidth;
				height = Math.round(width * (width < 600 ? 0.85 : ASPECT));
				const dpr = window.devicePixelRatio || 1;
				for (const c of [base, overlay]) {
					c.width = Math.round(width * dpr);
					c.height = Math.round(height * dpr);
					c.style.height = `${height}px`;
					c.getContext('2d')!.setTransform(dpr, 0, 0, dpr, 0, 0);
				}
				const extent: [[number, number], [number, number]] = [[PAD, PAD], [width - PAD, height - PAD]];
				const collection = (key: 'a' | 'b') => ({
					type: 'FeatureCollection',
					features: municipios.map((r) => ({ type: 'Feature', geometry: { type: 'MultiPolygon', coordinates: r.polygons[key] } })),
				});
				const pa = d3.geoIdentity().reflectY(true).fitExtent(extent, collection('a') as any);
				const pb = d3.geoIdentity().reflectY(true).fitExtent(extent, collection('b') as any);
				const project = (p: d3.GeoIdentityTransform, coords: number[][]) => {
					const out = new Float32Array(coords.length * 2);
					coords.forEach((c, i) => {
						const [x, y] = p(c as [number, number])!;
						out[2 * i] = x;
						out[2 * i + 1] = y;
					});
					return out;
				};
				const box = (arrays: Float32Array[]) => {
					let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
					for (const a of arrays) for (let i = 0; i < a.length; i += 2) {
						x0 = Math.min(x0, a[i]); x1 = Math.max(x1, a[i]);
						y0 = Math.min(y0, a[i + 1]); y1 = Math.max(y1, a[i + 1]);
					}
					return [x0, y0, x1, y1];
				};
				for (const r of [...municipios, ...states]) {
					const ringsA = r.polygons.a.flat();
					const ringsB = r.polygons.b.flat();
					// If a shape's rings ever fail to pair up, draw it without morphing instead of failing.
					const paired = ringsB.length === ringsA.length && ringsA.every((q, i) => q.length === ringsB[i].length);
					r.rings = ringsA.map((ring, i) => ({ a: project(pa, ring), b: paired ? project(pb, ringsB[i]) : project(pa, ring) }));
					r.boxA = box(r.rings.map((q) => q.a));
					r.boxB = box(r.rings.map((q) => q.b));
				}
				for (const m of Object.values(meshes)) {
					m.screen = m.lines.a.map((line, i) => ({ a: project(pa, line), b: project(pb, m.lines.b[i]) }));
				}
				zoom.extent([[0, 0], [width, height]]).translateExtent([[0, 0], [width, height]]);
				zoomT = d3.zoomIdentity;
				d3.select(base).property('__zoom', zoomT);
				draw();
			}

			function trace(ctx: CanvasRenderingContext2D, ring: Ring, close: boolean) {
				const { a, b } = ring;
				ctx.moveTo(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t);
				for (let i = 2; i < a.length; i += 2) {
					ctx.lineTo(a[i] + (b[i] - a[i]) * t, a[i + 1] + (b[i + 1] - a[i + 1]) * t);
				}
				if (close) ctx.closePath();
			}

			function valueOf(r: Region, id: string): number {
				return level === 'mun'
					? variables.municipios[id as keyof typeof variables.municipios][idIndex.get(r.id)!]
					: (variables.states as Record<string, Record<string, number>>)[r.id][id];
			}

			const format = (v: Variable, x: number) => (v.unit === '%' ? `${x.toFixed(x < 1 ? 2 : 1)}%` : `${x.toFixed(1)} years`);

			function color(r: Region) {
				if (colorVar === 'state') return stateColors[(parseInt(r.state) - 1) % stateColors.length];
				if (vars.has(colorVar)) return rateScales.get(colorVar)!(valueOf(r, colorVar));
				return level === 'mun' ? munScale(Math.max(500, r.population)) : stateScale(Math.max(500000, r.population));
			}

			function strokeMesh(ctx: CanvasRenderingContext2D, mesh: Mesh, style: string, lineWidth: number) {
				ctx.beginPath();
				for (const line of mesh.screen) trace(ctx, line, false);
				ctx.strokeStyle = style;
				ctx.lineWidth = lineWidth;
				ctx.stroke();
			}

			// The zoom transform maps layout pixels to screen pixels; strokes divide by k to stay thin.
			function prepare(canvas: HTMLCanvasElement) {
				const ctx = canvas.getContext('2d')!;
				const dpr = window.devicePixelRatio || 1;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.clearRect(0, 0, width, height);
				ctx.setTransform(dpr * zoomT.k, 0, 0, dpr * zoomT.k, dpr * zoomT.x, dpr * zoomT.y);
				return ctx;
			}

			function draw() {
				const ctx = prepare(base);
				ctx.lineJoin = 'round';
				for (const r of level === 'mun' ? municipios : states) {
					ctx.beginPath();
					for (const ring of r.rings) trace(ctx, ring, true);
					ctx.fillStyle = color(r);
					ctx.fill('evenodd');
				}
				const k = zoomT.k;
				if (level === 'mun') strokeMesh(ctx, meshes.mun, 'rgba(0, 0, 0, 0.28)', 0.35 / Math.sqrt(k));
				strokeMesh(ctx, meshes.state, 'rgba(255, 255, 255, 0.45)', (level === 'mun' ? 0.7 : 0.9) / k);
				strokeMesh(ctx, meshes.outline, 'rgba(255, 255, 255, 0.6)', 0.9 / k);
				drawHover();
			}

			function drawHover() {
				const ctx = prepare(overlay);
				for (const [r, fill, lineWidth] of [[selected, 'rgba(251, 191, 36, 0.18)', 2.5], [hovered, 'rgba(255, 255, 255, 0.12)', 1.5]] as const) {
					if (!r) continue;
					ctx.beginPath();
					for (const ring of r.rings) trace(ctx, ring, true);
					ctx.fillStyle = fill;
					ctx.fill('evenodd');
					ctx.strokeStyle = '#fbbf24';
					ctx.lineWidth = lineWidth / zoomT.k;
					ctx.stroke();
				}
			}

			function morphTo(target: number) {
				timer?.stop();
				hovered = null;
				hideTooltip();
				const from = t;
				if (reducedMotion || from === target) {
					t = target;
					draw();
					return;
				}
				timer = d3.timer((elapsed) => {
					const k = Math.min(1, elapsed / MORPH_MS);
					t = from + (target - from) * d3.easeCubicInOut(k);
					draw();
					if (k === 1) {
						timer!.stop();
						timer = null;
					}
				});
			}

			function inside(ring: Float32Array, x: number, y: number) {
				let hit = false;
				for (let i = 0, j = ring.length - 2; i < ring.length; j = i, i += 2) {
					const xi = ring[i], yi = ring[i + 1], xj = ring[j], yj = ring[j + 1];
					if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit;
				}
				return hit;
			}

			function regionAt(sx: number, sy: number): Region | null {
				const [x, y] = zoomT.invert([sx, sy]);
				const useB = t === 1;
				for (const r of level === 'mun' ? municipios : states) {
					const [x0, y0, x1, y1] = useB ? r.boxB : r.boxA;
					if (x < x0 || x > x1 || y < y0 || y > y1) continue;
					let hit = false;
					for (const ring of r.rings) if (inside(useB ? ring.b : ring.a, x, y)) hit = !hit;
					if (hit) return r;
				}
				return null;
			}

			function hideTooltip() {
				tooltip.style('opacity', 0);
			}

			function onPointer(event: PointerEvent) {
				if (timer || !municipios.length || event.pointerType === 'touch') return;
				const rect = base.getBoundingClientRect();
				const found = regionAt(event.clientX - rect.left, event.clientY - rect.top);
				if (found !== hovered) {
					hovered = found;
					drawHover();
				}
				if (!found) return hideTooltip();
				const share = ((found.population / 126014024) * 100).toFixed(found.population < 126014 ? 3 : 2);
				const where = level === 'mun' ? `<div class="tt-value">${names[found.state].name}</div>` : '';
				const v = vars.get(colorVar);
				const rate = v ? `<div class="tt-value">${v.label}: ${format(v, valueOf(found, v.id))} (Mexico ${format(v, v.national)})</div>` : '';
				tooltip
					.style('opacity', 1)
					.style('left', `${event.pageX + 12}px`)
					.style('top', `${event.pageY - 10}px`)
					.html(`<div class="tt-name">${found.name}</div>${where}
						<div class="tt-value">${found.population.toLocaleString('en-US')} people · ${share}% of Mexico</div>${rate}`);
			}

			const zoom = d3.zoom<HTMLCanvasElement, unknown>()
				.scaleExtent([1, 40])
				// Trackpad pinches send tiny ctrl-wheel deltas and need a boost; a mouse wheel notch (~100) does not.
				.wheelDelta((event: WheelEvent) =>
					-event.deltaY * (event.deltaMode === 1 ? 0.05 : event.deltaMode ? 1 : 0.002) * (event.ctrlKey && Math.abs(event.deltaY) < 50 ? 10 : 1))
				// Don't hijack page scrolling: wheel zoom needs ⌘/Ctrl (trackpad pinch sends ctrlKey), touch needs two fingers.
				.filter((event: any) => {
					if (event.type === 'wheel') return event.ctrlKey || event.metaKey;
					if (event.type === 'touchstart') return event.touches.length >= 2;
					return !event.button;
				})
				.on('zoom', (event) => {
					zoomT = event.transform;
					hovered = null;
					hideTooltip();
					draw();
				});
			d3.select(base).call(zoom);
			const zoomBy = (factor: number) => d3.select(base).transition().duration(250).call(zoom.scaleBy, factor);
			document.getElementById('zoom-in')!.addEventListener('click', () => zoomBy(1.8));
			document.getElementById('zoom-out')!.addEventListener('click', () => zoomBy(1 / 1.8));
			document.getElementById('zoom-reset')!.addEventListener('click', () =>
				d3.select(base).transition().duration(400).call(zoom.transform, d3.zoomIdentity));

			function zoomTo(r: Region) {
				const [x0, y0, x1, y1] = view === 'cartogram' ? r.boxB : r.boxA;
				const k = Math.max(1, Math.min(12, 0.6 / Math.max((x1 - x0) / width, (y1 - y0) / height)));
				const target = d3.zoomIdentity.translate(width / 2 - (k * (x0 + x1)) / 2, height / 2 - (k * (y0 + y1)) / 2).scale(k);
				d3.select(base).transition().duration(750).call(zoom.transform, target);
			}

			base.addEventListener('pointermove', onPointer);
			base.addEventListener('click', (event) => {
				if (timer || !municipios.length) return;
				const rect = base.getBoundingClientRect();
				select(regionAt(event.clientX - rect.left, event.clientY - rect.top));
			});
			base.addEventListener('pointerleave', () => {
				hovered = null;
				drawHover();
				hideTooltip();
			});

			function renderLegend() {
				const legend = d3.select('#legend');
				legend.html('');
				const v = vars.get(colorVar);
				if (v) {
					const [lo, hi] = v.domain;
					const scale = rateScales.get(v.id)!;
					const stops = d3.range(0, 1.0001, 0.1).map((k) => scale(lo + (hi - lo) * k)).join(', ');
					const at = Math.max(0, Math.min(100, ((v.national - lo) / (hi - lo)) * 100));
					legend.append('div').attr('class', 'legend-item').text(`≤ ${format(v, lo)}`);
					legend.append('div').attr('class', 'legend-bar').style('background', `linear-gradient(to right, ${stops})`)
						.append('div').attr('class', 'legend-marker').style('left', `${at}%`).attr('title', 'Mexico');
					legend.append('div').attr('class', 'legend-item').text(`≥ ${format(v, hi)}`);
					legend.append('div').attr('class', 'legend-item').text(`· white mark: Mexico ${format(v, v.national)}`);
					return;
				}
				if (colorVar !== 'population') return;
				const [scale, steps] = level === 'mun'
					? [munScale, [1000, 10000, 50000, 200000, 500000, 2000000]]
					: [stateScale, [700000, 2000000, 5000000, 10000000, 17000000]];
				for (const v of steps) {
					const label = v >= 1000000 ? `${(v / 1000000).toFixed(0)}M` : `${(v / 1000).toFixed(0)}K`;
					legend.append('div').attr('class', 'legend-item')
						.html(`<div class="legend-swatch" style="background:${scale(v)}"></div>${label}`);
				}
			}

			function setActive(ids: string[], activeId: string) {
				for (const id of ids) document.getElementById(id)!.classList.toggle('active', id === activeId);
			}

			function setView(next: 'cartogram' | 'normal') {
				view = next;
				setActive(['btn-cartogram', 'btn-normal'], next === 'cartogram' ? 'btn-cartogram' : 'btn-normal');
				syncURL();
			}
			document.getElementById('btn-cartogram')!.addEventListener('click', () => {
				setView('cartogram');
				morphTo(1);
			});
			document.getElementById('btn-normal')!.addEventListener('click', () => {
				setView('normal');
				morphTo(0);
			});

			function setLevel(next: 'mun' | 'state') {
				if (next === level) return;
				// A selected municipio becomes its state; a selected state can't become one municipio.
				selected = next === 'state' && selected ? states.find((s) => s.id === selected!.state) ?? null : null;
				level = next;
				setActive(['btn-mun', 'btn-state'], next === 'mun' ? 'btn-mun' : 'btn-state');
				hovered = null;
				hideTooltip();
				renderLegend();
				renderSelection();
				draw();
				syncURL();
			}
			document.getElementById('btn-mun')!.addEventListener('click', () => setLevel('mun'));
			document.getElementById('btn-state')!.addEventListener('click', () => setLevel('state'));

			const colorSelect = document.getElementById('color-select') as HTMLSelectElement;
			colorSelect.addEventListener('change', () => {
				colorVar = colorSelect.value;
				renderLegend();
				renderSelection();
				draw();
				syncURL();
			});

			function select(r: Region | null) {
				selected = r;
				renderSelection();
				drawHover();
				syncURL();
			}

			function renderSelection() {
				const el = document.getElementById('selection')!;
				el.hidden = !selected;
				if (!selected) return;
				const where = level === 'mun' ? `, ${names[selected.state].name}` : '';
				const v = vars.get(colorVar);
				const rate = v ? ` · ${v.label}: ${format(v, valueOf(selected, v.id))} (Mexico ${format(v, v.national)})` : '';
				el.innerHTML = `<strong>${selected.name}</strong>${where} · ${selected.population.toLocaleString('en-US')} people${rate}`;
			}

			// Shareable state: ?view=normal&level=state&color=hli&m=20067
			function syncURL() {
				const p = new URLSearchParams();
				if (view === 'normal') p.set('view', 'normal');
				if (level === 'state') p.set('level', 'state');
				if (colorVar !== 'population') p.set('color', colorVar);
				if (selected) p.set('m', selected.id);
				const query = p.toString();
				history.replaceState(null, '', query ? `?${query}` : location.pathname);
			}

			function applyURL() {
				const p = new URLSearchParams(location.search);
				if (p.get('view') === 'normal') setView('normal');
				if (p.get('level') === 'state') setLevel('state');
				const c = p.get('color');
				if (c && (c === 'state' || vars.has(c))) {
					colorVar = c;
					colorSelect.value = c;
				}
				const m = p.get('m');
				selected = (level === 'mun' ? municipios : states).find((r) => r.id === m) ?? null;
				syncURL();
			}

			// Find your municipio: accent- and case-insensitive.
			const fold = (text: string) => text.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
			const searchInput = document.getElementById('search') as HTMLInputElement;
			const results = document.getElementById('search-results') as HTMLUListElement;
			let matches: Region[] = [];
			let active = 0;

			function showResults() {
				results.replaceChildren(...matches.map((r, i) => {
					const li = document.createElement('li');
					li.setAttribute('role', 'option');
					li.className = i === active ? 'active' : '';
					li.append(r.name, Object.assign(document.createElement('span'), { className: 'state', textContent: `, ${names[r.state].name}` }));
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						choose(r);
					});
					return li;
				}));
				results.hidden = matches.length === 0;
			}

			function choose(r: Region) {
				setLevel('mun');
				select(r);
				zoomTo(r);
				searchInput.value = `${r.name}, ${names[r.state].name}`;
				matches = [];
				showResults();
			}

			searchInput.addEventListener('input', () => {
				const q = fold(searchInput.value.trim());
				active = 0;
				matches = q.length < 2 ? [] : municipios
					.map((r) => ({ r, key: fold(`${r.name} ${names[r.state].name}`), name: fold(r.name) }))
					.filter((x) => x.key.includes(q))
					.sort((a, b) => Number(b.name.startsWith(q)) - Number(a.name.startsWith(q)) || b.r.population - a.r.population)
					.slice(0, 8)
					.map((x) => x.r);
				showResults();
			});
			searchInput.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					active = (active + (e.key === 'ArrowDown' ? 1 : -1) + matches.length) % Math.max(1, matches.length);
					showResults();
				} else if (e.key === 'Enter' && matches[active]) {
					choose(matches[active]);
				} else if (e.key === 'Escape') {
					matches = [];
					showResults();
				}
			});
			searchInput.addEventListener('blur', () => {
				matches = [];
				showResults();
			});

			const copyButton = document.getElementById('copy-link') as HTMLButtonElement;
			copyButton.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(location.href);
					copyButton.textContent = 'Copied!';
				} catch {
					window.prompt('Copy this link', location.href);
				}
				setTimeout(() => (copyButton.textContent = 'Copy link'), 1500);
			});

			load();
		</script>
	</body>
</html>
