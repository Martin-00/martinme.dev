---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 5);

const projects = [
	{ href: '/cartogram', title: 'Mexico Population Cartogram', meta: 'Interactive map' },
	{ href: '/writings/how-i-deployed-martinme-dev/', title: 'This site', meta: 'AWS for $0.51/month' },
];
---

<!doctype html>
<html lang="en">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} keywords="Martin Morales, data engineer, AWS, Monterrey Mexico, cloud architecture, data visualization, cartogram, Terraform, OIDC" />
		<style>
			.home {
				max-width: 40em;
				margin: 0 auto;
				padding: 1em 0;
			}
			.intro header {
				text-align: center;
			}
			.intro h1 {
				font-size: 1.8em;
				font-weight: 650;
				margin: 0;
			}
			.intro .subtitle {
				font-size: 0.95em;
				color: rgba(255, 255, 255, 0.5);
				margin: 0.2em 0 0;
			}
			.intro hr {
				margin: 1.25em 0;
			}
			section {
				margin-top: 2.5em;
			}
			.section-head {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				padding-bottom: 0.4em;
				border-bottom: 1px solid rgba(255, 255, 255, 0.1);
			}
			.section-head h2 {
				font-size: 0.95em;
				font-variant: small-caps;
				letter-spacing: 0.08em;
				color: rgba(255, 255, 255, 0.8);
				margin: 0;
			}
			.section-head a {
				font-size: 0.8em;
				text-decoration: none;
			}
			.entries {
				list-style: none;
				padding: 0;
				margin: 0;
			}
			.entries li {
				margin: 0;
				border-bottom: 1px solid rgba(255, 255, 255, 0.05);
			}
			.entries a {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				gap: 1.5em;
				padding: 0.65em 0;
				color: #f0f0f0;
				text-decoration: none;
				transition: color 0.15s ease;
			}
			.entries a:hover {
				color: var(--accent);
			}
			.entries .meta {
				flex-shrink: 0;
				font-size: 0.75em;
				color: rgba(255, 255, 255, 0.4);
			}
			@media (max-width: 720px) {
				.entries a {
					flex-direction: column;
					gap: 0.1em;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="glass-card">
				<div class="home">
					<div class="intro">
						<header>
							<h1>Martin M. E.</h1>
							<p class="subtitle">Data Engineer. Builder. Monterrey, Mexico.</p>
						</header>
						<hr />
						<p>
							Hello! I build cloud infrastructure and data systems on AWS at
							<a href="https://caylent.com" target="_blank" rel="noopener noreferrer">Caylent</a>.
						</p>
						<p>
							I care about the welfare of all beings, and about whether the things we build
							make the world better or just faster. Technology is a vehicle. Where it goes
							matters more than how fast it moves. <a href="/about">More about me →</a>
						</p>
					</div>

					<section>
						<div class="section-head">
							<h2>Writings</h2>
							<a href="/writings">All writings →</a>
						</div>
						<ul class="entries">
							{
								posts.map((post) => (
									<li>
										<a href={`/writings/${post.id}/`}>
											<span>{post.data.title}</span>
											<span class="meta"><FormattedDate date={post.data.pubDate} /></span>
										</a>
									</li>
								))
							}
						</ul>
					</section>

					<section>
						<div class="section-head">
							<h2>Projects</h2>
							<a href="/projects">All projects →</a>
						</div>
						<ul class="entries">
							{
								projects.map((project) => (
									<li>
										<a href={project.href}>
											<span>{project.title}</span>
											<span class="meta">{project.meta}</span>
										</a>
									</li>
								))
							}
						</ul>
					</section>
				</div>
			</div>
		</main>
		<Footer />
	</body>
</html>
