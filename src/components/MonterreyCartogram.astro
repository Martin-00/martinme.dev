---
import BaseHead from './BaseHead.astro';
import Footer from './Footer.astro';
import Header from './Header.astro';
import metrics from '../assets/monterrey-cartogram/metrics.json';
import variables from '../assets/monterrey-cartogram/variables.json';

interface Props {
	lang: 'en' | 'es';
}
const { lang } = Astro.props;
const es = lang === 'es';
const locale = es ? 'es-MX' : 'en-US';
const fmt = (n: number) => n.toLocaleString(locale);
const shapes = metrics.shapes as Record<string, any>;
const available = Object.entries(shapes).filter(([, m]) => m.passes_gates).map(([name]) => name);
const people = shapes.people;
const empty = shapes.empty;
const facts = metrics.insights;
const gates = metrics.gates;
const muns = variables.municipios as Record<string, string>;
const label = (v: any) => (es ? v.label_es : v.label);
const groupOf = (v: any) => (es ? v.group_es : v.group);
const groups = [...new Set(variables.variables.map(groupOf))];
const worstIndex = variables.ids.indexOf(people.worst_tract);
const worst = { people: variables.population[worstIndex], municipio: muns[variables.tract_municipio[worstIndex]] };
const withheldTotalOnly = facts.empty_suppressed - empty.unknown_tracts;
const site = 'https://martinme.dev';
const href = { en: '/monterrey/', es: '/monterrey/es/' };

const t = es
	? {
			title: 'Cartograma de Monterrey: el área metropolitana por AGEB',
			description: 'Las 2,185 AGEB urbanas del área metropolitana de Monterrey se transforman del territorio en su gente y en sus viviendas deshabitadas. Censo 2020 de INEGI, coloreado por vivienda, mercado y personas.',
			keywords: 'cartograma Monterrey, mapa Monterrey, viviendas deshabitadas Monterrey, AGEB Monterrey, Censo 2020 INEGI, población Monterrey, área metropolitana de Monterrey, Nuevo León datos',
			h1: 'Monterrey, por su gente',
			subtitle: `Las ${fmt(facts.tracts)} AGEB urbanas del área metropolitana de Monterrey, del tamaño de quienes las habitan. Censo 2020 de INEGI.`,
			shape: { land: 'Territorio', people: 'Personas', empty: 'Viviendas deshabitadas' },
			shapeAria: 'Forma del mapa',
			colorAria: 'Colorear el mapa por',
			density: 'Color: personas por km²',
			municipio: 'Color: municipio',
			search: 'Buscar municipio',
			copy: 'Copiar enlace',
			loading: 'Cargando la ciudad...',
			hint: 'Acerca con dos dedos, o con ⌘/Ctrl + scroll; arrastra para explorar; toca una AGEB para seleccionarla.',
			canvas: 'Las AGEB urbanas del área metropolitana de Monterrey, del tamaño de su población',
			switchTo: { href: href.en, lang: 'en', label: 'English' },
		}
	: {
			title: 'Monterrey Cartogram - Metro Monterrey by Census Tract',
			description: "Metro Monterrey's 2,185 urban census tracts, morphing from the land into its people and its empty homes. INEGI Census 2020, colored by housing, market, and people measures.",
			keywords: 'Monterrey cartogram, Monterrey map, Monterrey population map, viviendas deshabitadas Monterrey, empty homes Monterrey, AGEB Monterrey, INEGI census 2020, Nuevo Leon data visualization',
			h1: 'Monterrey, by its people',
			subtitle: `Metro Monterrey's ${fmt(facts.tracts)} urban census tracts, sized by who lives there. INEGI Census 2020.`,
			shape: { land: 'Land', people: 'People', empty: 'Empty homes' },
			shapeAria: 'Map shape',
			colorAria: 'Color the map by',
			density: 'Color: people per km²',
			municipio: 'Color: municipio',
			search: 'Find a municipio',
			copy: 'Copy link',
			loading: 'Loading the city...',
			hint: 'Zoom with two fingers, or ⌘/Ctrl + scroll; drag to explore; tap a tract to select it.',
			canvas: "Metro Monterrey's urban census tracts, sized by population",
			switchTo: { href: href.es, lang: 'es', label: 'Español' },
		};

// Strings the browser script needs, in the page's language.
const client = es
	? {
			locale, lang, base: href.es, tract: 'AGEB', people: 'habitantes', tracts: 'AGEB',
			inUrbanTracts: 'habitantes en AGEB urbanas', notPublished: 'INEGI no lo publica', perKm2: 'personas por km²',
			noValue: 'sin dato, o sin viviendas ni habitantes', noResidents: 'sin habitantes',
			copy: t.copy, copied: '¡Copiado!', copyPrompt: 'Copia este enlace',
		}
	: {
			locale, lang, base: href.en, tract: 'Tract', people: 'people', tracts: 'tracts',
			inUrbanTracts: 'people in urban tracts', notPublished: 'not published by INEGI', perKm2: 'people per km²',
			noValue: 'withheld, or no homes or residents', noResidents: 'no residents',
			copy: t.copy, copied: 'Copied!', copyPrompt: 'Copy this link',
		};
---

<!doctype html>
<html lang={lang}>
	<head>
		<BaseHead title={t.title} description={t.description} keywords={t.keywords} />
		<link rel="alternate" hreflang="en" href={`${site}${href.en}`} />
		<link rel="alternate" hreflang="es" href={`${site}${href.es}`} />
		<link rel="alternate" hreflang="x-default" href={`${site}${href.en}`} />
		<style>
			.header {
				position: relative;
				text-align: center;
				margin-bottom: 0.75em;
			}
			.header h1 {
				font-size: 1.6em;
				margin: 0 0 0.2em;
			}
			.header .subtitle {
				font-size: 0.85em;
				color: rgba(255, 255, 255, 0.45);
				font-style: italic;
			}
			.lang-switch {
				display: inline-block;
				margin-top: 0.4em;
				font-size: 0.75em;
				letter-spacing: 0.04em;
				text-decoration: none;
			}
			.controls {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
				flex-wrap: wrap;
			}
			.controls button,
			.color-picker select,
			.search input,
			.copy-link {
				background: rgba(255, 255, 255, 0.05);
				border: 1px solid rgba(255, 255, 255, 0.15);
				color: rgba(255, 255, 255, 0.8);
				font-family: 'Source Serif', Georgia, serif;
				font-size: 0.75em;
				letter-spacing: 0.04em;
				padding: 0.35em 0.8em;
			}
			.controls button {
				cursor: pointer;
				transition: all 0.15s ease;
			}
			.controls button:hover,
			.copy-link:hover {
				color: var(--accent);
			}
			.controls button.active {
				background: rgba(251, 191, 36, 0.1);
				border-color: var(--accent);
				color: var(--accent);
			}
			.control-group {
				display: flex;
			}
			.control-group button {
				margin-left: -1px;
			}
			.control-group button:first-child {
				margin-left: 0;
			}
			.color-picker,
			.color-picker select {
				max-width: 100%;
			}
			.color-picker select {
				cursor: pointer;
			}
			.color-picker select:focus,
			.search input:focus {
				outline: none;
				border-color: var(--accent);
			}
			.color-picker option,
			.color-picker optgroup {
				background: #0a0f1e;
				color: #f0f0f0;
			}
			.finder {
				display: flex;
				justify-content: center;
				gap: 0.5em;
				margin-bottom: 0.75em;
			}
			.search {
				position: relative;
				flex: 1 1 auto;
				max-width: 22em;
			}
			.search input {
				width: 100%;
				box-sizing: border-box;
			}
			.copy-link {
				cursor: pointer;
				white-space: nowrap;
			}
			.search-results {
				position: absolute;
				z-index: 300;
				left: 0;
				right: 0;
				top: 100%;
				margin: 2px 0 0;
				padding: 0.25em 0;
				list-style: none;
				background: rgba(5, 10, 25, 0.97);
				border: 1px solid rgba(255, 255, 255, 0.15);
				max-height: 18em;
				overflow-y: auto;
			}
			.search-results :global(li) {
				margin: 0;
				padding: 0.3em 0.75em;
				font-size: 0.8em;
				color: rgba(255, 255, 255, 0.85);
				cursor: pointer;
			}
			.search-results :global(li.active),
			.search-results :global(li:hover) {
				background: rgba(251, 191, 36, 0.12);
				color: var(--accent);
			}
			.map {
				position: relative;
				width: 100%;
			}
			.map canvas {
				display: block;
				width: 100%;
			}
			.map #map-base {
				touch-action: pan-x pan-y;
				cursor: grab;
			}
			.map canvas + canvas {
				position: absolute;
				inset: 0;
				pointer-events: none;
			}
			.zoom-controls {
				position: absolute;
				top: 8px;
				right: 8px;
				display: flex;
				flex-direction: column;
				gap: 4px;
				z-index: 2;
			}
			.zoom-controls button {
				width: 30px;
				height: 30px;
				background: rgba(5, 10, 25, 0.85);
				border: 1px solid rgba(255, 255, 255, 0.2);
				color: rgba(255, 255, 255, 0.85);
				font-size: 16px;
				line-height: 1;
				cursor: pointer;
			}
			.zoom-controls button:hover {
				color: var(--accent);
				border-color: var(--accent);
			}
			.map-hint {
				text-align: center;
				font-size: 0.7em;
				color: rgba(255, 255, 255, 0.4);
				margin: 0.4em 0 0;
			}
			.loading {
				text-align: center;
				color: rgba(255, 255, 255, 0.4);
				padding: 3em 0;
				font-style: italic;
			}
			.legend {
				display: flex;
				justify-content: center;
				align-items: center;
				gap: 0.6em;
				margin: 0.75em auto 0;
				padding: 0.6em 1.2em;
				background: rgba(255, 255, 255, 0.03);
				border: 1px solid rgba(255, 255, 255, 0.06);
				border-radius: 6px;
				flex-wrap: wrap;
				font-size: 0.75em;
				color: rgba(255, 255, 255, 0.55);
				max-width: fit-content;
			}
			.legend:empty {
				display: none;
			}
			.legend :global(.legend-item) {
				display: flex;
				align-items: center;
				gap: 0.3em;
			}
			.legend :global(.legend-bar) {
				width: 12em;
				height: 10px;
				border-radius: 2px;
				border: 1px solid rgba(255, 255, 255, 0.1);
			}
			.legend :global(.legend-swatch) {
				width: 12px;
				height: 12px;
				border-radius: 2px;
				border: 1px solid rgba(255, 255, 255, 0.15);
			}
			.selection {
				text-align: center;
				font-size: 0.85em;
				color: rgba(255, 255, 255, 0.75);
				margin: 0.6em 0 0;
			}
			.selection :global(strong) {
				color: var(--accent);
			}
			.tooltip {
				position: absolute;
				background: rgba(5, 10, 25, 0.92);
				border: 1px solid rgba(255, 255, 255, 0.15);
				border-radius: 4px;
				padding: 0.5em 0.75em;
				font-size: 0.8em;
				color: #f0f0f0;
				pointer-events: none;
				opacity: 0;
				transition: opacity 0.15s ease;
				z-index: 200;
			}
			.tooltip :global(.tt-name) {
				font-weight: 600;
				margin-bottom: 0.2em;
			}
			.tooltip :global(.tt-value) {
				color: rgba(255, 255, 255, 0.65);
				font-size: 0.9em;
			}
			.story {
				margin-top: 2em;
				padding-top: 1.5em;
				border-top: 1px dotted rgba(255, 255, 255, 0.1);
			}
			.story h2 {
				font-size: 1.2em;
				font-variant: small-caps;
				margin-bottom: 0.75em;
			}
			.story p,
			.story li {
				font-size: 0.92em;
				color: rgba(255, 255, 255, 0.8);
				line-height: 1.65;
			}
			.big {
				color: var(--accent);
				font-weight: 650;
			}
			.note {
				font-size: 0.8em !important;
				color: rgba(255, 255, 255, 0.45) !important;
			}
			@media (max-width: 720px) {
				.controls {
					gap: 0.4em;
				}
				.color-picker {
					flex-basis: 100%;
				}
				.color-picker select {
					width: 100%;
				}
				.search {
					max-width: none;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<div class="glass-card">
				<div class="header">
					<h1>{t.h1}</h1>
					<p class="subtitle">{t.subtitle}</p>
					<a id="lang-switch" class="lang-switch" href={t.switchTo.href} hreflang={t.switchTo.lang} lang={t.switchTo.lang}>{t.switchTo.label}</a>
				</div>

				<div class="controls">
					<div class="control-group" role="group" aria-label={t.shapeAria}>
						<button data-shape="land">{t.shape.land}</button>
						{available.map((name) => <button data-shape={name}>{t.shape[name as 'people' | 'empty']}</button>)}
					</div>
					<label class="color-picker">
						<span class="sr-only">{t.colorAria}</span>
						<select id="color-select">
							<option value="density">{t.density}</option>
							<option value="municipio">{t.municipio}</option>
							{groups.map((g) => (
								<optgroup label={g}>
									{variables.variables.filter((v) => groupOf(v) === g).map((v) => <option value={v.id}>{label(v)}</option>)}
								</optgroup>
							))}
						</select>
					</label>
				</div>

				<div class="finder">
					<div class="search">
						<input id="search" type="search" placeholder={t.search} autocomplete="off" spellcheck="false" aria-label={t.search} aria-controls="search-results" />
						<ul id="search-results" class="search-results" role="listbox" hidden></ul>
					</div>
					<button id="copy-link" class="copy-link" type="button">{t.copy}</button>
				</div>

				<div class="map" id="map" data-strings={JSON.stringify(client)}>
					<div class="loading" id="loading">{t.loading}</div>
					<canvas id="map-base" role="img" aria-label={t.canvas}></canvas>
					<canvas id="map-overlay" aria-hidden="true"></canvas>
					<div class="zoom-controls">
						<button id="zoom-in" type="button" aria-label="+">+</button>
						<button id="zoom-out" type="button" aria-label="−">−</button>
						<button id="zoom-reset" type="button" aria-label="⟲">⟲</button>
					</div>
				</div>
				<p class="map-hint">{t.hint}</p>
				<div id="legend" class="legend"></div>
				<p id="selection" class="selection" aria-live="polite" hidden></p>
				<div class="tooltip" id="tooltip"></div>

				{es ? (
					<div class="story">
						<h2>Lo que revela la ciudad</h2>
						<p>
							La mitad de la población urbana del área metropolitana de Monterrey vive en el{' '}
							<span class="big">{facts.half_people_land_pct}%</span> de su suelo urbano. Cambia de "Territorio" a
							"Personas" y mira cómo se encogen los parques industriales y las orillas poco pobladas, mientras las zonas
							más densas crecen para ocupar su lugar.
						</p>
						<p>
							El censo cuenta <span class="big">{fmt(facts.empty_homes)}</span> viviendas deshabitadas en estas AGEB:
							casas que existen pero donde no vive nadie. No se reparten por igual.
						</p>
						<ul>
							{facts.empty_top.map((m) => (
								<li>
									<strong>{m.municipio}</strong> concentra el {m.empty_share_pct}% de las viviendas deshabitadas del área
									metropolitana y el {m.people_share_pct}% de su población.
								</li>
							))}
						</ul>
						<p>
							En <span class="big">{fmt(facts.tracts_over_30pct_empty)}</span> AGEB, más del 30% de las viviendas están
							deshabitadas.
							{available.includes('empty') && ' Cambia a "Viviendas deshabitadas" para ver la ciudad del tamaño de ellas.'}
						</p>

						<h2>Cómo se hizo</h2>
						<p>
							Los límites son las AGEB urbanas del Marco Geoestadístico de INEGI hecho para el Censo 2020; los datos vienen
							de los resultados por AGEB y manzana urbana de Nuevo León. El área metropolitana son los 18 municipios de la
							Zona Metropolitana de Monterrey oficial. Cada AGEB se compara con la cifra oficial de su municipio. Las AGEB
							tienen claves, no nombres de colonia, así que se identifican por clave y municipio.
						</p>
						<p>
							Todas las formas comparten una sola topología, para que la ciudad pueda transformarse entre ellas, y cada una
							se calculó con el algoritmo de flujo de Gastner, Seguy y More. Los criterios de calidad se fijaron antes de
							ver cualquier resultado: error de área mediano de máximo {gates.median_pct}%, 90% de las AGEB dentro de
							{gates.p90_pct}% y traslape de máximo {gates.overlap_pct}% del mapa. Una forma solo aparece aquí si los
							cumple todos.
						</p>
						<ul>
							<li>
								<strong>Personas:</strong> error de área mediano de {people.median_pct}%, 90% de las AGEB dentro de
								{people.p90_pct}% y traslape de {people.overlap_pct}% del mapa. Las AGEB con menos de
								{fmt(Math.round(people.floor_value))} habitantes ({fmt(people.tracts_floored)} AGEB, casi todas industriales
								o sin viviendas) se dibujan con ese tamaño mínimo, que ocupa el {people.floor_extra_map_share_pct}% del mapa.
							</li>
							<li>
								<strong>Viviendas deshabitadas:</strong>{' '}
								{empty.passes_gates
									? `error de área mediano de ${empty.median_pct}%, 90% de las AGEB dentro de ${empty.p90_pct}% y traslape de ${empty.overlap_pct}% del mapa. INEGI no publica la cifra de ${fmt(empty.unknown_tracts)} AGEB; se dibujan con el tamaño mínimo, junto con las que tienen menos de ${fmt(Math.round(empty.floor_value))} viviendas deshabitadas (${empty.floor_extra_map_share_pct}% del mapa).`
									: 'no pasó los criterios de calidad en esta versión, así que no se muestra como forma.'}
							</li>
							<li>
								El gris significa que la AGEB no tiene dato: INEGI reserva las cifras pequeñas para proteger la privacidad,
								y algunas AGEB no tienen viviendas ni habitantes. En viviendas deshabitadas, {fmt(facts.empty_suppressed)} AGEB
								tienen una cifra reservada ({fmt(empty.unknown_tracts)} la de viviendas deshabitadas y {fmt(withheldTotalOnly)}
								el total de viviendas) y {fmt(facts.tracts_without_homes)} no tienen viviendas.
							</li>
							<li>
								La AGEB peor ajustada, con {fmt(worst.people)} habitantes en {worst.municipio}, se dibuja con el
								{people.worst_tract_area_share_pct}% del mapa, más que su proporción: una mota de unos cuantos píxeles.
							</li>
						</ul>
						<p class="note">
							Datos: INEGI, Censo de Población y Vivienda 2020 (resultados por AGEB y manzana urbana; Marco
							Geoestadístico). Definición metropolitana: Metrópolis de México 2020 (SEDATU, CONAPO, INEGI). Algoritmo:
							Gastner, Seguy y More (2018), PNAS. Hecho con el mismo proceso que el
							<a href="/cartogram">cartograma de México</a> (en inglés).
						</p>
					</div>
				) : (
					<div class="story">
						<h2>What the city reveals</h2>
						<p>
							Half of metro Monterrey's urban residents live on <span class="big">{facts.half_people_land_pct}%</span> of
							its urban land. Switch from "Land" to "People" and watch the industrial parks and the sparsely built edges
							shrink, while the dense neighborhoods swell to take their place.
						</p>
						<p>
							The census counts <span class="big">{fmt(facts.empty_homes)}</span> empty homes in these tracts: houses
							that exist but shelter no one. They don't fall evenly.
						</p>
						<ul>
							{facts.empty_top.map((m) => (
								<li>
									<strong>{m.municipio}</strong> holds {m.empty_share_pct}% of the metro's empty homes and{' '}
									{m.people_share_pct}% of its people.
								</li>
							))}
						</ul>
						<p>
							In <span class="big">{fmt(facts.tracts_over_30pct_empty)}</span> tracts, more than 30% of homes are empty.
							{available.includes('empty') && ' Switch to "Empty homes" to see the city sized by them instead.'}
						</p>

						<h2>How it was built</h2>
						<p>
							Boundaries are INEGI's urban census tracts (AGEB) from the Marco Geoestadistico made for the 2020 census;
							values come from the census by tract and block for Nuevo Leon. The metro area is the 18 municipios of the
							official Zona Metropolitana de Monterrey. Each tract is compared with its own municipio's official figure.
							Census tracts have codes, not neighborhood names, so tracts are labeled by code and municipio.
						</p>
						<p>
							Every shape shares one topology, so the city can morph between them, and each was computed with the
							Gastner-Seguy-More flow-based algorithm. Quality gates were written down before any result was seen: median
							area error at most {gates.median_pct}%, 90% of tracts within {gates.p90_pct}%, overlap at most
							{gates.overlap_pct}% of the map. A shape only appears here if it passes them all.
						</p>
						<ul>
							<li>
								<strong>People:</strong> median area error {people.median_pct}%, 90% of tracts within {people.p90_pct}%,
								overlap {people.overlap_pct}% of the map. Tracts with fewer than {fmt(Math.round(people.floor_value))}
								residents ({fmt(people.tracts_floored)} tracts, mostly industrial or without homes) are drawn at that
								minimum size, which takes {people.floor_extra_map_share_pct}% of the map.
							</li>
							<li>
								<strong>Empty homes:</strong>{' '}
								{empty.passes_gates
									? `median area error ${empty.median_pct}%, 90% of tracts within ${empty.p90_pct}%, overlap ${empty.overlap_pct}% of the map. INEGI does not publish the count for ${fmt(empty.unknown_tracts)} tracts; they are drawn at the minimum size, with the tracts below ${fmt(Math.round(empty.floor_value))} empty homes (${empty.floor_extra_map_share_pct}% of the map).`
									: "did not pass the quality gates in this build, so it isn't shown as a shape."}
							</li>
							<li>
								Gray means a tract has no value: INEGI withholds small counts to protect privacy, and some tracts have no
								homes or residents at all. For empty homes, {fmt(facts.empty_suppressed)} tracts have a withheld count
								({fmt(empty.unknown_tracts)} withhold the empty-home count, {fmt(withheldTotalOnly)} the total number of
								homes) and {fmt(facts.tracts_without_homes)} have no homes.
							</li>
							<li>
								The worst-fitting tract, home to {fmt(worst.people)} people in {worst.municipio}, is drawn at
								{people.worst_tract_area_share_pct}% of the map, larger than its share: a speck of a few pixels.
							</li>
						</ul>
						<p class="note">
							Data: INEGI, Censo de Poblacion y Vivienda 2020 (census by urban tract and block; Marco Geoestadistico).
							Metro definition: Metropolis de Mexico 2020 (SEDATU, CONAPO, INEGI). Algorithm: Gastner, Seguy and More
							(2018), PNAS. Built with the same pipeline as the <a href="/cartogram">Mexico cartogram</a>.
						</p>
					</div>
				)}
			</div>
		</main>
		<Footer />

		<script>
			import * as d3 from 'd3';
			import topoUrl from '../assets/monterrey-cartogram/monterrey.topo.json?url';
			import variables from '../assets/monterrey-cartogram/variables.json';

			type Ring = Record<string, Float32Array>;
			type Tract = {
				index: number;
				id: string;
				code: string;
				municipio: string;
				population: number;
				rings: number[][];
				stitched: Record<string, number[][][]>;
				screen: Ring[];
				box: Record<string, number[]>;
				areaKm2: number;
			};
			type Variable = (typeof variables.variables)[number];

			const PAD = 8;
			const MORPH_MS = 1200;
			const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
			const NOT_PUBLISHED = '#3b4150';

			const container = document.getElementById('map')!;
			const S = JSON.parse(container.dataset.strings!);
			const es = S.lang === 'es';
			const base = document.getElementById('map-base') as HTMLCanvasElement;
			const overlay = document.getElementById('map-overlay') as HTMLCanvasElement;
			const tooltip = d3.select('#tooltip');
			const vars = new Map<string, Variable>(variables.variables.map((v) => [v.id, v]));
			const munNames = variables.municipios as Record<string, string>;
			const munCodes = Object.keys(munNames);
			const munColor = d3.scaleOrdinal<string, string>(munCodes, d3.quantize((k) => d3.interpolateSinebow(k * 0.9), munCodes.length));
			const rateScales = new Map(variables.variables.map((v) =>
				[v.id, d3.scaleSequential(d3.interpolateYlGnBu).domain(v.domain as [number, number]).clamp(true)]));
			const densityScale = d3.scaleSequentialLog(d3.interpolateYlOrRd).domain([500, 30000]).clamp(true);
			const num = (n: number) => n.toLocaleString(S.locale);
			const labelOf = (v: Variable) => (es ? v.label_es : v.label);

			let shapeNames: string[] = ['land'];
			let from = 'land';
			let to = 'land';
			let t = 1;
			let colorVar = 'empty';
			let tracts: Tract[] = [];
			let lines: Record<'tract' | 'municipio' | 'outline', { coords: Record<string, number[][][]>; screen: Ring[] }>;
			let hovered: Tract | null = null;
			let selected: Tract | null = null;
			let selectedMun: string | null = null;
			let timer: d3.Timer | null = null;
			let width = 0;
			let height = 0;
			let zoomT = d3.zoomIdentity;
			let targetShape = 'people';

			const decode = (transform: any, arcs: number[][][]) => {
				const [sx, sy] = transform.scale;
				const [tx, ty] = transform.translate;
				return arcs.map((arc) => {
					let x = 0, y = 0;
					return arc.map(([dx, dy]) => [(x += dx) * sx + tx, (y += dy) * sy + ty]);
				});
			};

			async function load() {
				const topo = await fetch(topoUrl).then((r) => r.json());
				const arcs: Record<string, number[][][]> = { land: decode(topo.transform, topo.arcs) };
				for (const [name, s] of Object.entries<any>(topo.shapes)) arcs[name] = decode(s.transform, s.arcs);
				shapeNames = Object.keys(arcs);
				const geoms = topo.objects.tracts.geometries;
				const ringArcs = (g: any): number[][] => (g.type === 'Polygon' ? [g.arcs] : g.arcs).flat();
				const stitch = (shape: string, ring: number[]) => {
					const out: number[][] = [];
					for (const i of ring) {
						const part = i >= 0 ? arcs[shape][i] : arcs[shape][~i].slice().reverse();
						out.push(...(out.length ? part.slice(1) : part));
					}
					return out;
				};
				tracts = geoms.map((g: any, index: number) => {
					const rings = ringArcs(g);
					const stitched = Object.fromEntries(shapeNames.map((s) => [s, rings.map((r) => stitch(s, r))]));
					return {
						index,
						id: g.properties.id,
						code: variables.tract_code[index],
						municipio: variables.tract_municipio[index],
						population: variables.population[index],
						rings,
						stitched,
						screen: [],
						box: {},
						areaKm2: Math.abs(d3.sum(stitched.land, (r) => d3.polygonArea(r as [number, number][]))) / 1e6,
					};
				});
				// Border lines picked per arc by which tracts it separates (never by matching coordinates).
				const owners = new Map<number, number[]>();
				geoms.forEach((g: any, gi: number) => {
					for (const ring of ringArcs(g)) for (const i of ring) {
						const k = i < 0 ? ~i : i;
						owners.set(k, [...(owners.get(k) || []), gi]);
					}
				});
				const pick = (keep: (a: number, b: number | undefined) => boolean) => {
					const ks = [...owners].filter(([, o]) => keep(o[0], o[1])).map(([k]) => k);
					return { coords: Object.fromEntries(shapeNames.map((s) => [s, ks.map((k) => arcs[s][k])])), screen: [] as Ring[] };
				};
				const mun = (gi: number) => variables.tract_municipio[gi];
				lines = {
					tract: pick((a, b) => b !== undefined && mun(a) === mun(b)),
					municipio: pick((a, b) => b !== undefined && mun(a) !== mun(b)),
					outline: pick((a, b) => b === undefined),
				};

				document.getElementById('loading')!.remove();
				applyURL();
				new ResizeObserver(layout).observe(container);
				layout();
				if (targetShape !== 'land' && !reducedMotion) setTimeout(() => morphTo(targetShape), 700);
				else showShape(targetShape);
				renderLegend();
				renderSelection();
				syncURL();
			}

			function layout() {
				width = container.clientWidth;
				height = Math.round(width * (width < 600 ? 1.0 : 0.72));
				const dpr = window.devicePixelRatio || 1;
				for (const c of [base, overlay]) {
					c.width = Math.round(width * dpr);
					c.height = Math.round(height * dpr);
					c.style.height = `${height}px`;
				}
				const extent: [[number, number], [number, number]] = [[PAD, PAD], [width - PAD, height - PAD]];
				const fits = Object.fromEntries(shapeNames.map((s) => [s, d3.geoIdentity().reflectY(true).fitExtent(extent, {
					type: 'MultiPoint', coordinates: tracts.flatMap((tr) => tr.stitched[s].flat()),
				} as any)]));
				const project = (p: any, coords: number[][]) => {
					const out = new Float32Array(coords.length * 2);
					coords.forEach((c, i) => {
						const [x, y] = p(c as [number, number])!;
						out[2 * i] = x;
						out[2 * i + 1] = y;
					});
					return out;
				};
				const box = (arrays: Float32Array[]) => {
					let x0 = Infinity, y0 = Infinity, x1 = -Infinity, y1 = -Infinity;
					for (const a of arrays) for (let i = 0; i < a.length; i += 2) {
						x0 = Math.min(x0, a[i]); x1 = Math.max(x1, a[i]);
						y0 = Math.min(y0, a[i + 1]); y1 = Math.max(y1, a[i + 1]);
					}
					return [x0, y0, x1, y1];
				};
				for (const tr of tracts) {
					tr.screen = tr.rings.map((_, k) => Object.fromEntries(shapeNames.map((s) => [s, project(fits[s], tr.stitched[s][k])])));
					tr.box = Object.fromEntries(shapeNames.map((s) => [s, box(tr.screen.map((r) => r[s]))]));
				}
				for (const l of Object.values(lines)) {
					l.screen = l.coords.land.map((_, k) => Object.fromEntries(shapeNames.map((s) => [s, project(fits[s], l.coords[s][k])])));
				}
				zoom.extent([[0, 0], [width, height]]).translateExtent([[0, 0], [width, height]]);
				zoomT = d3.zoomIdentity;
				d3.select(base).property('__zoom', zoomT);
				draw();
			}

			function trace(ctx: CanvasRenderingContext2D, ring: Ring, close: boolean) {
				const a = ring[from], b = ring[to];
				ctx.moveTo(a[0] + (b[0] - a[0]) * t, a[1] + (b[1] - a[1]) * t);
				for (let i = 2; i < a.length; i += 2) ctx.lineTo(a[i] + (b[i] - a[i]) * t, a[i + 1] + (b[i + 1] - a[i + 1]) * t);
				if (close) ctx.closePath();
			}

			const valueOf = (tr: Tract, id: string) => (variables.values as Record<string, (number | null)[]>)[id][tr.index];
			const munValue = (m: string, id: string) => (variables.municipio_values as Record<string, Record<string, number | null>>)[id][m];
			const format = (v: Variable, x: number) => {
				const digits = v.unit === '%' ? (x < 1 ? 2 : 1) : v.unit === 'years' ? 1 : 2;
				const n = x.toLocaleString(S.locale, { minimumFractionDigits: digits, maximumFractionDigits: digits });
				return v.unit === '%' ? `${n}%` : `${n} ${es ? v.unit_es : v.unit}`;
			};

			function color(tr: Tract) {
				if (colorVar === 'municipio') return munColor(tr.municipio);
				if (colorVar === 'density') return tr.population ? densityScale(Math.max(500, tr.population / tr.areaKm2)) : NOT_PUBLISHED;
				const v = valueOf(tr, colorVar);
				return v === null || v === undefined ? NOT_PUBLISHED : rateScales.get(colorVar)!(v);
			}

			function prepare(canvas: HTMLCanvasElement) {
				const ctx = canvas.getContext('2d')!;
				const dpr = window.devicePixelRatio || 1;
				ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
				ctx.clearRect(0, 0, width, height);
				ctx.setTransform(dpr * zoomT.k, 0, 0, dpr * zoomT.k, dpr * zoomT.x, dpr * zoomT.y);
				return ctx;
			}

			function strokeLines(ctx: CanvasRenderingContext2D, rings: Ring[], style: string, w: number) {
				ctx.beginPath();
				for (const r of rings) trace(ctx, r, false);
				ctx.strokeStyle = style;
				ctx.lineWidth = w;
				ctx.stroke();
			}

			function draw() {
				const ctx = prepare(base);
				ctx.lineJoin = 'round';
				for (const tr of tracts) {
					ctx.beginPath();
					for (const ring of tr.screen) trace(ctx, ring, true);
					ctx.fillStyle = color(tr);
					ctx.fill('evenodd');
				}
				const k = zoomT.k;
				strokeLines(ctx, lines.tract.screen, 'rgba(0, 0, 0, 0.3)', 0.3 / Math.sqrt(k));
				strokeLines(ctx, lines.municipio.screen, 'rgba(255, 255, 255, 0.55)', 0.9 / k);
				strokeLines(ctx, lines.outline.screen, 'rgba(255, 255, 255, 0.65)', 0.9 / k);
				drawOverlay();
			}

			function drawOverlay() {
				const ctx = prepare(overlay);
				const outline = (list: Tract[], fill: string, w: number) => {
					if (!list.length) return;
					ctx.beginPath();
					for (const tr of list) for (const ring of tr.screen) trace(ctx, ring, true);
					ctx.fillStyle = fill;
					ctx.fill('evenodd');
					ctx.strokeStyle = '#fbbf24';
					ctx.lineWidth = w / zoomT.k;
					ctx.stroke();
				};
				outline(selectedMun ? tracts.filter((tr) => tr.municipio === selectedMun) : [], 'rgba(251, 191, 36, 0.08)', 1);
				outline(selected ? [selected] : [], 'rgba(251, 191, 36, 0.2)', 2.5);
				outline(hovered ? [hovered] : [], 'rgba(255, 255, 255, 0.15)', 1.5);
			}

			function showShape(shape: string) {
				from = to = shape;
				t = 1;
				setActiveShape(shape);
				draw();
			}

			function morphTo(shape: string) {
				if (!shapeNames.includes(shape) || (shape === to && t === 1)) return;
				timer?.stop();
				from = t === 1 ? to : t > 0.5 ? to : from;
				to = shape;
				t = 0;
				hovered = null;
				hideTooltip();
				setActiveShape(shape);
				syncURL();
				if (reducedMotion) return showShape(shape);
				timer = d3.timer((elapsed) => {
					const k = Math.min(1, elapsed / MORPH_MS);
					t = d3.easeCubicInOut(k);
					draw();
					if (k === 1) {
						timer!.stop();
						timer = null;
					}
				});
			}

			function setActiveShape(shape: string) {
				document.querySelectorAll<HTMLButtonElement>('[data-shape]').forEach((b) => b.classList.toggle('active', b.dataset.shape === shape));
			}

			function inside(ring: Float32Array, x: number, y: number) {
				let hit = false;
				for (let i = 0, j = ring.length - 2; i < ring.length; j = i, i += 2) {
					const xi = ring[i], yi = ring[i + 1], xj = ring[j], yj = ring[j + 1];
					if (yi > y !== yj > y && x < ((xj - xi) * (y - yi)) / (yj - yi) + xi) hit = !hit;
				}
				return hit;
			}

			function tractAt(sx: number, sy: number): Tract | null {
				if (t !== 1) return null;
				const [x, y] = zoomT.invert([sx, sy]);
				for (const tr of tracts) {
					const [x0, y0, x1, y1] = tr.box[to];
					if (x < x0 || x > x1 || y < y0 || y > y1) continue;
					let hit = false;
					for (const ring of tr.screen) if (inside(ring[to], x, y)) hit = !hit;
					if (hit) return tr;
				}
				return null;
			}

			function describe(tr: Tract) {
				const v = vars.get(colorVar);
				let value = '';
				if (v) {
					const x = valueOf(tr, v.id);
					const m = munValue(tr.municipio, v.id);
					value = `${labelOf(v)}: ${x === null ? S.notPublished : format(v, x)}${m === null ? '' : ` (${munNames[tr.municipio]} ${format(v, m)})`}`;
				} else if (colorVar === 'density') {
					value = `${num(Math.round(tr.population / tr.areaKm2))} ${S.perKm2}`;
				}
				return { title: `${S.tract} ${tr.code}, ${munNames[tr.municipio]}`, people: `${num(tr.population)} ${S.people}`, value };
			}

			function hideTooltip() {
				tooltip.style('opacity', 0);
			}

			function onPointer(event: PointerEvent) {
				if (timer || !tracts.length || event.pointerType === 'touch') return;
				const rect = base.getBoundingClientRect();
				const found = tractAt(event.clientX - rect.left, event.clientY - rect.top);
				if (found !== hovered) {
					hovered = found;
					drawOverlay();
				}
				if (!found) return hideTooltip();
				const d = describe(found);
				tooltip.style('opacity', 1).style('left', `${event.pageX + 12}px`).style('top', `${event.pageY - 10}px`)
					.html(`<div class="tt-name">${d.title}</div><div class="tt-value">${d.people}</div>${d.value ? `<div class="tt-value">${d.value}</div>` : ''}`);
			}

			const zoom = d3.zoom<HTMLCanvasElement, unknown>()
				.scaleExtent([1, 60])
				.wheelDelta((event: WheelEvent) =>
					-event.deltaY * (event.deltaMode === 1 ? 0.05 : event.deltaMode ? 1 : 0.002) * (event.ctrlKey && Math.abs(event.deltaY) < 50 ? 10 : 1))
				.filter((event: any) => {
					if (event.type === 'wheel') return event.ctrlKey || event.metaKey;
					if (event.type === 'touchstart') return event.touches.length >= 2;
					return !event.button;
				})
				.on('zoom', (event) => {
					zoomT = event.transform;
					hovered = null;
					hideTooltip();
					draw();
				});
			d3.select(base).call(zoom);
			const zoomBy = (f: number) => d3.select(base).transition().duration(250).call(zoom.scaleBy, f);
			document.getElementById('zoom-in')!.addEventListener('click', () => zoomBy(1.8));
			document.getElementById('zoom-out')!.addEventListener('click', () => zoomBy(1 / 1.8));
			document.getElementById('zoom-reset')!.addEventListener('click', () => d3.select(base).transition().duration(400).call(zoom.transform, d3.zoomIdentity));

			function zoomToBox([x0, y0, x1, y1]: number[]) {
				const k = Math.max(1, Math.min(20, 0.7 / Math.max((x1 - x0) / width, (y1 - y0) / height)));
				const target = d3.zoomIdentity.translate(width / 2 - (k * (x0 + x1)) / 2, height / 2 - (k * (y0 + y1)) / 2).scale(k);
				d3.select(base).transition().duration(750).call(zoom.transform, target);
			}

			base.addEventListener('pointermove', onPointer);
			base.addEventListener('pointerleave', () => {
				hovered = null;
				drawOverlay();
				hideTooltip();
			});
			base.addEventListener('click', (event) => {
				if (timer || !tracts.length) return;
				const rect = base.getBoundingClientRect();
				selected = tractAt(event.clientX - rect.left, event.clientY - rect.top);
				if (selected) selectedMun = null;
				renderSelection();
				drawOverlay();
				syncURL();
			});

			document.querySelectorAll<HTMLButtonElement>('[data-shape]').forEach((b) => b.addEventListener('click', () => morphTo(b.dataset.shape!)));
			const colorSelect = document.getElementById('color-select') as HTMLSelectElement;
			colorSelect.addEventListener('change', () => {
				colorVar = colorSelect.value;
				renderLegend();
				renderSelection();
				draw();
				syncURL();
			});

			function renderLegend() {
				const legend = d3.select('#legend');
				legend.html('');
				const v = vars.get(colorVar);
				const gradient = (scale: (x: number) => string, lo: number, hi: number, log = false) => {
					const stops = d3.range(0, 1.0001, 0.1).map((k) => scale(log ? lo * Math.pow(hi / lo, k) : lo + (hi - lo) * k)).join(', ');
					legend.append('div').attr('class', 'legend-bar').style('background', `linear-gradient(to right, ${stops})`);
				};
				if (v) {
					const [lo, hi] = v.domain;
					legend.append('div').attr('class', 'legend-item').text(`≤ ${format(v, lo)}`);
					gradient(rateScales.get(v.id)!, lo, hi);
					legend.append('div').attr('class', 'legend-item').text(`≥ ${format(v, hi)}`);
				} else if (colorVar === 'density') {
					legend.append('div').attr('class', 'legend-item').text(`≤ ${num(500)} / km²`);
					gradient(densityScale, 500, 30000, true);
					legend.append('div').attr('class', 'legend-item').text(`≥ ${num(30000)} / km²`);
				}
				if (colorVar !== 'municipio') {
					legend.append('div').attr('class', 'legend-item')
						.html(`<div class="legend-swatch" style="background:${NOT_PUBLISHED}"></div>${colorVar === 'density' ? S.noResidents : S.noValue}`);
				}
			}

			function renderSelection() {
				const el = document.getElementById('selection')!;
				if (selected) {
					const d = describe(selected);
					el.innerHTML = `<strong>${d.title}</strong> · ${d.people}${d.value ? ` · ${d.value}` : ''}`;
				} else if (selectedMun) {
					const list = tracts.filter((tr) => tr.municipio === selectedMun);
					const v = vars.get(colorVar);
					const m = v ? munValue(selectedMun, v.id) : null;
					el.innerHTML = `<strong>${munNames[selectedMun]}</strong> · ${num(list.length)} ${S.tracts} · ${num(d3.sum(list, (tr) => tr.population))} ${S.inUrbanTracts}${v && m !== null ? ` · ${labelOf(v)}: ${format(v, m)}` : ''}`;
				}
				el.hidden = !selected && !selectedMun;
			}

			// Shareable state: ?shape=empty&color=car&tract=1903900010250 (or &m=018). The language link keeps it.
			const langLink = document.getElementById('lang-switch') as HTMLAnchorElement;
			const langBase = langLink.getAttribute('href')!;
			function syncURL() {
				const p = new URLSearchParams();
				if (to !== 'people') p.set('shape', to);
				if (colorVar !== 'empty') p.set('color', colorVar);
				if (selected) p.set('tract', selected.id);
				else if (selectedMun) p.set('m', selectedMun);
				const q = p.toString();
				history.replaceState(null, '', q ? `?${q}` : location.pathname);
				langLink.href = q ? `${langBase}?${q}` : langBase;
			}

			function applyURL() {
				const p = new URLSearchParams(location.search);
				const s = p.get('shape');
				targetShape = s && shapeNames.includes(s) ? s : shapeNames.includes('people') ? 'people' : 'land';
				const c = p.get('color');
				if (c && (vars.has(c) || c === 'density' || c === 'municipio')) colorVar = c;
				colorSelect.value = colorVar;
				selected = tracts.find((tr) => tr.id === p.get('tract')) ?? null;
				const m = p.get('m');
				selectedMun = !selected && m && munNames[m] ? m : null;
			}

			// Find a municipio: accent- and case-insensitive.
			const fold = (text: string) => text.normalize('NFD').replace(/\p{Diacritic}/gu, '').toLowerCase();
			const searchInput = document.getElementById('search') as HTMLInputElement;
			const results = document.getElementById('search-results') as HTMLUListElement;
			let matches: string[] = [];
			let active = 0;

			function showResults() {
				results.replaceChildren(...matches.map((m, i) => {
					const li = document.createElement('li');
					li.setAttribute('role', 'option');
					li.className = i === active ? 'active' : '';
					li.textContent = munNames[m];
					li.addEventListener('mousedown', (e) => {
						e.preventDefault();
						chooseMun(m);
					});
					return li;
				}));
				results.hidden = matches.length === 0;
			}

			function chooseMun(m: string) {
				selected = null;
				selectedMun = m;
				searchInput.value = munNames[m];
				matches = [];
				showResults();
				renderSelection();
				drawOverlay();
				syncURL();
				const boxes = tracts.filter((tr) => tr.municipio === m).map((tr) => tr.box[to]);
				zoomToBox([d3.min(boxes, (b) => b[0])!, d3.min(boxes, (b) => b[1])!, d3.max(boxes, (b) => b[2])!, d3.max(boxes, (b) => b[3])!]);
			}

			searchInput.addEventListener('input', () => {
				const q = fold(searchInput.value.trim());
				active = 0;
				matches = q.length < 1 ? [] : munCodes.filter((m) => fold(munNames[m]).includes(q))
					.sort((a, b) => Number(fold(munNames[b]).startsWith(q)) - Number(fold(munNames[a]).startsWith(q)));
				showResults();
			});
			searchInput.addEventListener('keydown', (e) => {
				if (e.key === 'ArrowDown' || e.key === 'ArrowUp') {
					e.preventDefault();
					active = (active + (e.key === 'ArrowDown' ? 1 : -1) + matches.length) % Math.max(1, matches.length);
					showResults();
				} else if (e.key === 'Enter' && matches[active]) {
					chooseMun(matches[active]);
				} else if (e.key === 'Escape') {
					matches = [];
					showResults();
				}
			});
			searchInput.addEventListener('blur', () => {
				matches = [];
				showResults();
			});

			const copyButton = document.getElementById('copy-link') as HTMLButtonElement;
			copyButton.addEventListener('click', async () => {
				try {
					await navigator.clipboard.writeText(location.href);
					copyButton.textContent = S.copied;
				} catch {
					window.prompt(S.copyPrompt, location.href);
				}
				setTimeout(() => (copyButton.textContent = S.copy), 1500);
			});

			load();
		</script>
	</body>
</html>
